# Ignore runtime files
data/
__pycache__/
.pytest_cache/
*.py[cod]
.env

# One person's reading of their own history, not part of the app.
importer-rules.toml

# A working note, absorbed into seed.py. Never part of the app.
categories.toml

# Answers the importer remembers. Regenerated by being asked again.
importer-decisions.toml

# A database's own seed, read instead of seed.toml. One person's working hours
# and vocabulary are theirs, not a default the app ships.
seed-local.toml
